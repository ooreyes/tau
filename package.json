{
  "name": "tau",
  "private": true,
  "version": "1.0.0",
  "description": "Tau - a modern, fast circuit simulator with a SPICE-class engine.",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --filter @tau/desktop tauri dev",
    "dev:web": "pnpm --filter @tau/desktop dev",
    "build": "pnpm --filter @tau/desktop tauri build",
    "refresh:app": "bash scripts/refresh-tau-app.sh",
    "typecheck": "pnpm --filter @tau/desktop exec tsc --noEmit",
    "test": "pnpm --filter @tau/desktop test",
    "design:shot": "node scripts/design-shot.mjs"
  }
}
