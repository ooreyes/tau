diff --git a/src/xspice/icm/analog/ota/cfunc.mod b/src/xspice/icm/analog/ota/cfunc.mod
index e82ee0e..9b16ef4 100644
--- a/src/xspice/icm/analog/ota/cfunc.mod
+++ b/src/xspice/icm/analog/ota/cfunc.mod
@@ -23,6 +23,7 @@ SUMMARY
 ================================================================================
 */
 
+#include <math.h>
 #include <stdlib.h>
 
 
@@ -31,6 +32,7 @@ void cm_ota(ARGS)
     double gm_val = PARAM(gm);
     double rout = PARAM(rout);
     double rin = PARAM(rin);
+    double iout = PARAM(iout);
 
     Mif_Complex_t ac_gain;
 
@@ -84,8 +86,20 @@ void cm_ota(ARGS)
         double v_in = INPUT(inp);
         double v_out = INPUT(out);
 
-        OUTPUT(out) = gm_val * v_in + v_out / rout;
-        PARTIAL(out, inp) = gm_val;
+        double drive;
+        double drive_gain;
+        if (iout < 1.0e29) {
+            double limited = tanh(gm_val * v_in / iout);
+            drive = iout * limited;
+            drive_gain = gm_val * (1.0 - limited * limited);
+        }
+        else {
+            drive = gm_val * v_in;
+            drive_gain = gm_val;
+        }
+
+        OUTPUT(out) = drive + v_out / rout;
+        PARTIAL(out, inp) = drive_gain;
         PARTIAL(out, out) = 1.0 / rout;
 
         OUTPUT(inp) = v_in / rin;
@@ -95,7 +109,14 @@ void cm_ota(ARGS)
         Mif_Complex_t ac_rout;
         Mif_Complex_t ac_rin;
 
-        ac_gain.real = gm_val;
+        double v_in = INPUT(inp);
+        if (iout < 1.0e29) {
+            double limited = tanh(gm_val * v_in / iout);
+            ac_gain.real = gm_val * (1.0 - limited * limited);
+        }
+        else {
+            ac_gain.real = gm_val;
+        }
         ac_gain.imag = 0.0;
         AC_GAIN(out, inp) = ac_gain;
 
