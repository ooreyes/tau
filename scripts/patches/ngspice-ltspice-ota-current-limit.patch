diff --git a/src/xspice/icm/analog/ota/cfunc.mod b/src/xspice/icm/analog/ota/cfunc.mod
index e82ee0e16..4664a4c59 100644
--- a/src/xspice/icm/analog/ota/cfunc.mod
+++ b/src/xspice/icm/analog/ota/cfunc.mod
@@ -23,6 +23,7 @@ SUMMARY
 ================================================================================
 */
 
+#include <math.h>
 #include <stdlib.h>
 
 
@@ -31,6 +32,9 @@ void cm_ota(ARGS)
     double gm_val = PARAM(gm);
     double rout = PARAM(rout);
     double rin = PARAM(rin);
+    double iout = PARAM(iout);
+    double isource = PARAM(isource);
+    double isink = PARAM(isink);
 
     Mif_Complex_t ac_gain;
 
@@ -84,8 +88,25 @@ void cm_ota(ARGS)
         double v_in = INPUT(inp);
         double v_out = INPUT(out);
 
-        OUTPUT(out) = gm_val * v_in + v_out / rout;
-        PARTIAL(out, inp) = gm_val;
+        /* LTspice OTA: I = Ilim*tanh(gm*Vin/Ilim). Symmetric Iout, or
+         * asymmetric Isource (Vin>=0) / |Isink| (Vin<0) when those are set. */
+        double drive;
+        double drive_gain;
+        double i_pos = (isource < 1.0e29) ? isource : iout;
+        double i_neg = (fabs(isink) < 1.0e29) ? fabs(isink) : iout;
+        double i_lim = (v_in >= 0.0) ? i_pos : i_neg;
+        if (i_lim < 1.0e29) {
+            double limited = tanh(gm_val * v_in / i_lim);
+            drive = i_lim * limited;
+            drive_gain = gm_val * (1.0 - limited * limited);
+        }
+        else {
+            drive = gm_val * v_in;
+            drive_gain = gm_val;
+        }
+
+        OUTPUT(out) = drive + v_out / rout;
+        PARTIAL(out, inp) = drive_gain;
         PARTIAL(out, out) = 1.0 / rout;
 
         OUTPUT(inp) = v_in / rin;
@@ -95,7 +116,17 @@ void cm_ota(ARGS)
         Mif_Complex_t ac_rout;
         Mif_Complex_t ac_rin;
 
-        ac_gain.real = gm_val;
+        double v_in = INPUT(inp);
+        double i_pos = (isource < 1.0e29) ? isource : iout;
+        double i_neg = (fabs(isink) < 1.0e29) ? fabs(isink) : iout;
+        double i_lim = (v_in >= 0.0) ? i_pos : i_neg;
+        if (i_lim < 1.0e29) {
+            double limited = tanh(gm_val * v_in / i_lim);
+            ac_gain.real = gm_val * (1.0 - limited * limited);
+        }
+        else {
+            ac_gain.real = gm_val;
+        }
         ac_gain.imag = 0.0;
         AC_GAIN(out, inp) = ac_gain;
 
